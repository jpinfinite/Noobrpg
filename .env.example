# ==============================================================================
# NOOBRPG — ARQUIVO DE EXEMPLO DE CONFIGURAÇÃO DE AMBIENTE (.env.example)
#
# AVISO DE SEGURANÇA OPERACIONAL:
# 1. NUNCA insira credenciais reais, tokens, chaves secretas ou senhas neste arquivo.
# 2. Utilize exclusivamente valores fictícios e placeholders (ex.: seu_token_aqui).
# 3. Em produção ou CI/CD, injete variáveis pelo processo ou cofre de segredos.
# 4. O arquivo `.env` com valores reais NUNCA deve ser commitado no repositório.
# ==============================================================================

# Servidor e Ambiente
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Segredos de Sessão e Criptografia
SESSION_SECRET=dev_change_this_to_a_secure_random_string_in_production_32chars

# Configuração de Banco de Dados
# DATABASE_TYPE: 'sqlite' (modo local autônomo) ou 'postgres' (serviço gerenciado como Supabase/Neon)
DATABASE_TYPE=sqlite
SQLITE_PATH=./dev.sqlite

# Exemplo de URL para PostgreSQL gerenciado em nuvem:
# DATABASE_URL=postgresql://postgres:suasenha@db.supabase.co:5432/postgres?sslmode=require

# Cloudflare Configuration
CLOUDFLARE_ACCOUNT_ID=seu_account_id_aqui
CLOUDFLARE_API_TOKEN=seu_api_token_aqui

# Cloudflare R2 (S3-compatible Object Storage)
R2_ACCESS_KEY_ID=seu_access_key_id_aqui
R2_SECRET_ACCESS_KEY=seu_secret_access_key_aqui
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=noobrpg-assets
R2_PUBLIC_URL=https://assets.noobrpg.com
