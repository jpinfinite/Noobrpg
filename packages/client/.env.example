# Variáveis de Ambiente do Cliente NoobRPG (Vite + Phaser 3)
# Copie este arquivo para .env ao customizar endpoints locais ou de staging.
# NOTA DE SEGURANÇA: Todas as variáveis prefixadas com VITE_ são públicas e incorporadas ao bundle!
# NUNCA insira tokens, senhas ou chaves privadas neste arquivo.

# URL base da API REST do backend
# Desenvolvimento local: deixar vazio ou usar /api (o proxy do Vite encaminha para localhost:4000)
# Staging / Produção: URL HTTPS pública do servidor ou do Cloudflare Tunnel (ex: https://tunnel.meudominio.com/api)
VITE_API_URL=/api

# URL do servidor WebSocket autoritativo
# Desenvolvimento local: deixar vazio (o cliente adota automaticamente ws://localhost:4000/ws)
# Staging / Produção: URL WSS pública do servidor ou do Cloudflare Tunnel (ex: wss://tunnel.meudominio.com/ws)
VITE_WS_URL=

# URL base para carregamento de assets (opcional; padrão: ./assets)
VITE_ASSETS_BASE_URL=./assets
